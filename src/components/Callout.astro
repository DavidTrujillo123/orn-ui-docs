---
// Un solo callout para todo el sitio. Antes había cuatro implementaciones
// del mismo patrón visual con valores levemente distintos: .warning y
// .warning-note en GettingStartedContent, .provider-note en
// ComponentPageLayout, .callout en AtomicDesignContent. Misma señal
// (advertencia/nota), un solo lugar donde cambiarla.
interface Props {
  variant?: 'warn' | 'info';
  href?: string;
}
const { variant = 'warn', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class={`callout callout-${variant}`} href={href}>
  <span class="callout-icon" aria-hidden="true">
    {variant === 'warn' ? (
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
    ) : (
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
    )}
  </span>
  <span class="callout-body"><slot /></span>
</Tag>

<style>
  .callout {
    display: flex; gap: var(--space-md); align-items: flex-start;
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--text);
    text-decoration: none;
  }
  .callout-icon { flex-shrink: 0; margin-top: 2px; }
  .callout-body { margin: 0; }
  .callout-body :global(strong) { color: var(--text); }

  /* warn: ámbar, para lo que puede romper algo (UIProvider faltante, etc). */
  .callout-warn {
    background: color-mix(in srgb, #f59e0b 12%, var(--surface));
    border: 1px solid color-mix(in srgb, #f59e0b 40%, var(--border));
  }
  .callout-warn .callout-icon { color: #f59e0b; }
  a.callout-warn:hover { border-color: #f59e0b; }

  /* info: primary, para una nota que aclara pero no bloquea. */
  .callout-info {
    background: color-mix(in srgb, var(--primary) 10%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--primary) 35%, var(--border));
  }
  .callout-info .callout-icon { color: var(--primary); }
  a.callout-info:hover { border-color: var(--primary); }
</style>
