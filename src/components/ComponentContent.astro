---
// Página de un componente individual. Solo prepara los datos: el orden de las
// secciones y los estilos viven en ComponentPageLayout.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, getComponentUsage, type Lang } from '../i18n/ui';
import { buildComponentMarkdown } from '../lib/markdown';
import { GROUP_SLUG_REDIRECTS } from '../lib/groupedPages';
import { getFlatNavList } from '../lib/navGroups';
import ComponentPageLayout, { type DepChip } from './ComponentPageLayout.astro';
import components from '../data/components.json';

interface Props { lang: Lang; component: any; markdownUrl: string }
const { lang, component, markdownUrl } = Astro.props;
const t = useTranslations(lang);
const markdown = buildComponentMarkdown(component, t, lang);
const usage = getComponentUsage(lang, component.slug);

// Orden del sidebar; da la vuelta al llegar a los extremos.
const flatList = getFlatNavList(components, lang, t);
const ownHref = getRelativeLocaleUrl(lang, `/components/${component.slug}`);
const ownIndex = flatList.findIndex((item) => item.href === ownHref);
const nextItem = ownIndex !== -1 ? flatList[(ownIndex + 1) % flatList.length] : null;
const prevItem = ownIndex !== -1 ? flatList[(ownIndex - 1 + flatList.length) % flatList.length] : null;

const deps: DepChip[] = (component.registry?.registryDependencies ?? []).map((dep: string) => {
  if (dep === 'core') return { label: t('install.core'), italic: true };
  const redirect = GROUP_SLUG_REDIRECTS[dep];
  if (redirect) return { label: redirect.label, href: getRelativeLocaleUrl(lang, redirect.href) };
  return { label: dep, href: getRelativeLocaleUrl(lang, `/components/${dep}`) };
});
---

<ComponentPageLayout
  lang={lang}
  kicker={component.category}
  title={component.name}
  mediaSlug={component.mediaSlug}
  backHref={`${getRelativeLocaleUrl(lang, '/')}#components`}
  markdownUrl={markdownUrl}
  markdown={markdown}
  providerHref={getRelativeLocaleUrl(lang, '/getting-started')}
  installSlug={component.registry ? component.slug : undefined}
  installImport={`import { ${component.name} } from 'orn-ui/${component.slug}';`}
  deps={deps}
  usage={usage}
  variants={component.variants ?? []}
  snippet={component.snippet}
  props={component.props ?? []}
  prevItem={prevItem}
  nextItem={nextItem}
/>
