---
// Layout único de las páginas de componente. Todas —las individuales y las
// de grupo, como Typography— pasan por aquí, así que comparten el mismo
// orden de secciones y los mismos estilos:
//
//   1. acciones de página (volver + markdown)
//   2. cabecera (categoría + nombre)
//   3. hero: contenido a la izquierda (lede, provider, instalación, uso)
//      y el gif a la derecha
//   4. ejemplo combinado
//   5. variantes
//   6. código fuente completo
//   7. props
//   8. paginación
//
// Las secciones sin datos no se renderizan; el orden nunca cambia.
import { Code } from 'astro:components';
import { useTranslations, getPropDescription, getPropDefault, type Lang } from '../i18n/ui';
import NextItemLink from './NextItemLink.astro';

export interface DepChip { label: string; href?: string; italic?: boolean }
export interface UsageEntry { term: string; desc: string }
export interface VariantEntry { label: string; code: string }
export interface PagerEntry { href: string; label: string }

interface Props {
  lang: Lang;
  kicker: string;
  title: string;
  mediaSlug: string;
  lede?: string;
  backHref: string;
  markdownUrl?: string;
  markdown?: string;
  providerHref: string;
  installSlug?: string;
  installImport?: string;
  installNote?: string;
  deps?: DepChip[];
  usage?: UsageEntry[];
  combinedExample?: string;
  combinedTitle?: string;
  variants?: VariantEntry[];
  snippet?: string;
  props?: any[];
  propsNote?: string;
  // Nombre del tipo dueño de las props, para buscar sus descripciones
  // traducidas. Por defecto, el nombre del componente.
  propsOwner?: string;
  prevItem?: PagerEntry | null;
  nextItem?: PagerEntry | null;
}

const {
  lang,
  kicker,
  title,
  mediaSlug,
  lede,
  backHref,
  markdownUrl,
  markdown,
  providerHref,
  installSlug,
  installImport,
  installNote,
  deps = [],
  usage = [],
  combinedExample,
  combinedTitle,
  variants = [],
  snippet,
  props = [],
  propsNote,
  propsOwner,
  prevItem,
  nextItem,
} = Astro.props;

const t = useTranslations(lang);
const codeThemes = { light: 'github-light' as const, dark: 'github-dark' as const };
---

<div class="page-actions">
  <a class="back" href={backHref}>{t('component.back')}</a>
  {markdownUrl && markdown && (
    <div class="md-actions">
      <a class="md-link" href={markdownUrl}>{t('md.viewButton')}</a>
      <button type="button" class="md-copy-btn" data-copy-md data-md={markdown}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        {t('md.copyButton')}
      </button>
    </div>
  )}
</div>

<div class="header">
  <span class="kicker">{kicker}</span>
  <h1>{title}</h1>
</div>

<div class="hero-row">
  <div class="hero-left">
    {lede && <p class="lede">{lede}</p>}

    <a class="provider-note" href={providerHref}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      <span><strong>{t('gs.requiresProvider')}</strong> — {t('gs.linkText')} →</span>
    </a>

    {installSlug && (
      <section class="install">
        <h2>{t('install.title')}</h2>
        <div class="install-option">
          <p class="install-label">{t('install.cli')}</p>
          <Code code={`npx orn-ui add ${installSlug}`} lang="bash" themes={codeThemes} defaultColor={false} />
        </div>
        {installImport && (
          <div class="install-option">
            <p class="install-label">{t('install.package')}</p>
            <Code code={`pnpm add orn-ui\n${installImport}`} lang="tsx" themes={codeThemes} defaultColor={false} />
          </div>
        )}
        {installNote && <p class="install-note">{installNote}</p>}
        {deps.length > 0 && (
          <div class="install-deps">
            <span class="install-label">{t('install.dependsOn')}</span>
            {deps.map((dep) =>
              dep.href
                ? <a class="dep-chip" href={dep.href}>{dep.label}</a>
                : <span class={`dep-chip${dep.italic ? ' dep-chip-core' : ''}`}>{dep.label}</span>
            )}
          </div>
        )}
      </section>
    )}

    {usage.length > 0 && (
      <section class="usage">
        <h2>{t('component.usage')}</h2>
        <ul class="usage-list">
          {usage.map((u) => (
            <li><strong>{u.term}</strong> — {u.desc}</li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <div class="media-col">
    <div class="media-frame">
      <img
        src={`/media/${mediaSlug}.gif`}
        alt={`${title} demo`}
        loading="lazy"
        onerror="this.closest('.media-frame').classList.add('media-missing')"
      />
      <div class="media-placeholder">{t('component.mediaMissing')}</div>
    </div>
  </div>
</div>

{combinedExample && (
  <section class="example">
    <h2>{combinedTitle ?? t('component.variants')}</h2>
    <Code code={combinedExample} lang="tsx" themes={codeThemes} defaultColor={false} />
  </section>
)}

{variants.length > 0 && (
  <section class="variants">
    <h2>{t('component.variants')}</h2>
    {variants.map((v) => (
      <div class="variant">
        <h3>{v.label}</h3>
        <Code code={v.code} lang="tsx" themes={codeThemes} defaultColor={false} />
      </div>
    ))}
  </section>
)}

{snippet && (
  <details class="full-source">
    <summary>{t('component.fullSource')}</summary>
    <Code code={snippet} lang="tsx" themes={codeThemes} defaultColor={false} />
  </details>
)}

<h2>{t('component.props')}</h2>
{propsNote && <p class="props-note">{propsNote}</p>}
{props.length > 0 ? (
  <div class="props-table">
    <table>
      <thead>
        <tr>
          <th>{t('props.name')}</th>
          <th>{t('props.type')}</th>
          <th>{t('props.default')}</th>
          <th>{t('props.description')}</th>
        </tr>
      </thead>
      <tbody>
        {props.map((p: any) => (
          <tr>
            <td><code>{p.name}{p.required ? '' : '?'}</code></td>
            <td><code>{p.type}</code></td>
            <td>{getPropDefault(lang, propsOwner ?? title, p.name, p.defaultValue) ?? '—'}</td>
            <td>{getPropDescription(lang, propsOwner ?? title, p.name, p.description) || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
) : (
  <p>{t('component.noProps')}</p>
)}

{(prevItem || nextItem) && (
  <div class="pager-row">
    {prevItem && <NextItemLink direction="prev" href={prevItem.href} label={prevItem.label} eyebrow={t('nav.prev')} />}
    {nextItem && <NextItemLink direction="next" href={nextItem.href} label={nextItem.label} eyebrow={t('nav.next')} />}
  </div>
)}

<style>
  .page-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .back { font-size: 13px; color: var(--text-light); text-decoration: none; }
  .back:hover { color: var(--primary); }
  .md-actions { display: flex; align-items: center; gap: 8px; }
  .md-link {
    font-size: 12px; color: var(--text-light); text-decoration: none;
    padding: 6px 10px; border-radius: 999px; border: 1px solid var(--border);
  }
  .md-link:hover { color: var(--primary); border-color: var(--primary); }
  .md-copy-btn {
    display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600;
    color: var(--text-light); background: var(--surface); border: 1px solid var(--border);
    border-radius: 999px; padding: 6px 12px; cursor: pointer; transition: color 0.15s, border-color 0.15s;
  }
  .md-copy-btn:hover { color: var(--primary); border-color: var(--primary); }
  .md-copy-btn.copied { color: #16a34a; border-color: #16a34a; }

  .header { margin: 16px 0 12px; }
  .kicker { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--primary); }
  h1 { margin: 4px 0 0; font-size: 32px; }
  h2 { font-size: 20px; margin: 32px 0 12px; }
  .lede { color: var(--text-light); font-size: 15px; max-width: 560px; line-height: 1.6; margin-bottom: 20px; }

  /* Contenido a la izquierda, gif a la derecha con un ancho mínimo propio. */
  .hero-row { display: grid; grid-template-columns: 3fr minmax(240px, 1fr); align-items: stretch; gap: 32px; }
  .hero-left { min-width: 0; }
  /* La columna se estira a la altura del texto y el gif entra completo dentro
     (contain), así no queda hueco debajo cuando la imagen es más alta. */
  .media-col { position: relative; min-height: 420px; }
  .media-frame {
    position: absolute; inset: 0; overflow: hidden;
    display: flex; align-items: flex-start; justify-content: center;
  }
  .media-frame img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: top center; }
  .media-placeholder { display: none; padding: 32px; color: var(--text-light); font-size: 13px; text-align: center; }
  .media-frame.media-missing {
    align-items: center; justify-content: center;
    background: var(--code-bg); border: 1px solid var(--border); border-radius: var(--radius);
  }
  .media-frame.media-missing img { display: none; }
  .media-frame.media-missing .media-placeholder { display: block; }
  @media (max-width: 800px) {
    .hero-row { grid-template-columns: 1fr; }
    .media-col { justify-self: center; width: 260px; height: 420px; min-height: 0; }
  }

  .provider-note {
    display: flex; align-items: center; gap: 8px;
    background: color-mix(in srgb, #f59e0b 12%, var(--surface));
    border: 1px solid color-mix(in srgb, #f59e0b 40%, var(--border));
    color: var(--text);
    border-radius: var(--radius);
    padding: 10px 14px;
    margin-bottom: 24px;
    font-size: 13px;
    text-decoration: none;
  }
  .provider-note svg { flex-shrink: 0; color: #f59e0b; }
  .provider-note:hover { border-color: #f59e0b; }

  .install { margin-bottom: 0; }
  .install-option { margin-bottom: 14px; }
  .install-option :global(pre) { margin: 4px 0 0; }
  .install-label {
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-light); margin: 0;
  }
  .install-note { font-size: 13px; color: var(--text-light); margin: 4px 0 0; }
  .install-deps { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
  .dep-chip {
    font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px;
    background: var(--code-bg); color: var(--text); border: 1px solid var(--border);
    text-decoration: none;
  }
  a.dep-chip:hover { border-color: var(--primary); color: var(--primary); }
  .dep-chip-core { color: var(--text-light); font-style: italic; }

  .usage { margin-bottom: 0; }
  .usage-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .usage-list li { font-size: 14px; color: var(--text-light); line-height: 1.5; }
  .usage-list strong { color: var(--text); }

  .example :global(pre) { margin: 0; }

  .variants { margin-bottom: 32px; }
  .variants h2 { margin-bottom: 16px; }
  .variant { margin-bottom: 24px; }
  .variant h3 {
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-light); margin: 0 0 8px;
  }
  .variant :global(pre) { margin: 0; }

  .full-source { margin-bottom: 32px; }
  .full-source summary {
    cursor: pointer; font-size: 14px; color: var(--text-light); padding: 8px 0; user-select: none;
  }
  .full-source summary:hover { color: var(--primary); }
  .full-source :global(pre) { margin-top: 8px; }

  .props-note { font-size: 13px; color: var(--text-light); margin: -4px 0 12px; }
  .props-table { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--text-light); font-weight: 600; background: var(--code-bg); }
  tr:last-child td { border-bottom: none; }

  .pager-row { display: flex; gap: 16px; margin-top: 40px; flex-wrap: wrap; }
  @media (max-width: 480px) { .pager-row { flex-direction: column; } }
</style>
