---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Code } from 'astro:components';
import { useTranslations, type Lang } from '../i18n/ui';
import Callout from './Callout.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const appSnippet = `import { UIProvider } from 'orn-ui';

export default function App() {
  return (
    <UIProvider>
      {/* your navigator / screens go here */}
    </UIProvider>
  );
}`;

const safeAreaSnippet = `import { SafeAreaUIProvider } from 'orn-ui/safe-area';

export default function App() {
  return (
    <SafeAreaUIProvider>
      {/* your navigator / screens go here */}
    </SafeAreaUIProvider>
  );
}`;

const safeAreaProps = [
  { name: 'insets', type: 'EdgeInsets', required: false, default: 'measured via useSafeAreaInsets()', description: { en: 'Explicit override — wins over the measured value. Useful for tests, Storybook, or a screen that does not fill the window.', es: 'Override explícito — gana sobre el valor medido. Útil para tests, Storybook, o una pantalla que no ocupa la ventana entera.' } },
  { name: 'mountSafeAreaProvider', type: 'boolean', required: false, default: 'true', description: { en: 'Also mount <SafeAreaProvider>. Set false if your app already has one above.', es: 'También monta <SafeAreaProvider>. Ponlo en false si tu app ya tiene uno arriba.' } },
];

// Versiones exactas que publica cada SDK soportado. Las mismas que corre la
// matriz de compatibilidad del repo (packages/ui/scripts/compat-matrix.mjs):
// si esa tabla se mueve, esta tiene que moverse con ella.
const supportedSdks = [
  { sdk: '54', reactNative: '0.81.5', react: '19.1.0' },
  { sdk: '55', reactNative: '0.83.10', react: '19.2.0' },
  { sdk: '56', reactNative: '0.85.3', react: '19.2.3' },
  { sdk: '57', reactNative: '0.86.2', react: '19.2.3' },
];

const uiProviderProps = [
  { name: 'children', type: 'React.ReactNode', required: true, default: '—', description: { en: 'Your app — mounted once, above the navigator.', es: 'Tu app — montado una sola vez, arriba del navigator.' } },
  { name: 'theme', type: 'ThemePair', required: false, default: 'defaultTheme', description: { en: 'Light/dark pair. Build one with createTheme().', es: 'Par light/dark. Se crea con createTheme().' } },
  { name: 'defaultMode', type: "'system' | 'light' | 'dark'", required: false, default: "'system'", description: { en: 'Initial mode, uncontrolled.', es: 'Modo inicial, no controlado.' } },
  { name: 'mode', type: "'system' | 'light' | 'dark'", required: false, default: '—', description: { en: 'Controlled mode — pass with onModeChange to manage it yourself.', es: 'Modo controlado — pásalo junto a onModeChange para manejarlo tú.' } },
  { name: 'onModeChange', type: '(mode: ThemeMode) => void', required: false, default: '—', description: { en: 'Called on toggle when mode is controlled.', es: 'Se llama al togglear, cuando mode es controlado.' } },
  { name: 'icons', type: 'IconRenderer', required: false, default: 'renderDefaultIcon', description: { en: 'Icon renderer. Defaults to the zero-dep glyphs bundled with orn-ui.', es: 'Renderer de íconos. Por defecto usa los glifos zero-dep incluidos.' } },
  { name: 'insets', type: 'EdgeInsets', required: false, default: 'zeroInsets', description: { en: 'Safe-area insets, typically from useSafeAreaInsets().', es: 'Insets de safe area, típicamente de useSafeAreaInsets().' } },
  { name: 'labels', type: 'Partial<Labels>', required: false, default: 'defaultLabels', description: { en: 'Override any built-in string (Close, Cancel, Search…).', es: 'Sobreescribe cualquier string interno (Close, Cancel, Search…).' } },
  { name: 'allowFontScaling', type: 'boolean', required: false, default: 'false', description: { en: 'Off by default, for parity across the library.', es: 'Apagado por defecto, para paridad en toda la librería.' } },
];
---

<a class="back" href={`${getRelativeLocaleUrl(lang, '/')}#components`}>{t('component.back')}</a>
<h1>{t('gs.h1')}</h1>
<p class="lede">{t('gs.lede')}</p>

<section class="step">
  <h2>{t('gs.step1.title')}</h2>
  <p>{t('gs.step1.body')}</p>
  <div class="install-pair">
    <pre><code>pnpm add orn-ui</code></pre>
    <span class="install-or">/</span>
    <pre><code>npx orn-ui add button</code></pre>
  </div>

  <div class="compat">
    <h3 class="compat-title">{t('gs.compat.title')}</h3>
    <p>{t('gs.compat.body')}</p>
    <div class="props-table">
      <table>
        <thead>
          <tr>
            <th>{t('gs.compat.col.sdk')}</th>
            <th>react-native</th>
            <th>react</th>
          </tr>
        </thead>
        <tbody>
          {supportedSdks.map((row) => (
            <tr>
              <td>{row.sdk}</td>
              <td><code>{row.reactNative}</code></td>
              <td><code>{row.react}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="compat-note">{t('gs.compat.peers')}</p>
    <Callout variant="info">{t('gs.compat.expoGo')}</Callout>
  </div>
</section>

<section class="step">
  <h2>{t('gs.step2.title')}</h2>
  <p>{t('gs.step2.body')}</p>
  <Code code={appSnippet} lang="tsx" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
  <Callout variant="warn">{t('gs.step2.warning')}</Callout>

  <h3 class="eyebrow">{t('gs.props.title')}</h3>
  <div class="props-table">
    <table>
      <thead>
        <tr>
          <th>{t('props.name')}</th>
          <th>{t('props.type')}</th>
          <th>{t('props.default')}</th>
          <th>{t('props.description')}</th>
        </tr>
      </thead>
      <tbody>
        {uiProviderProps.map((p) => (
          <tr>
            <td><code>{p.name}{p.required ? '' : '?'}</code></td>
            <td><code>{p.type}</code></td>
            <td>{p.default}</td>
            <td>{p.description[lang]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="safe-area">
    <h3 class="safe-area-title">{t('gs.safeArea.title')}</h3>
    <p>{t('gs.safeArea.body')}</p>
    <p>{t('gs.safeArea.subpath')}</p>
    <p class="eyebrow install-label">{t('gs.safeArea.install')}</p>
    <pre><code>pnpm add react-native-safe-area-context</code></pre>
    <Code code={safeAreaSnippet} lang="tsx" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
    <Callout variant="info">{t('gs.safeArea.nestedNote')}</Callout>

    <h3 class="eyebrow">{t('gs.safeArea.propsTitle')}</h3>
    <p class="props-note">{t('gs.safeArea.propsNote')}</p>
    <div class="props-table">
      <table>
        <thead>
          <tr>
            <th>{t('props.name')}</th>
            <th>{t('props.type')}</th>
            <th>{t('props.default')}</th>
            <th>{t('props.description')}</th>
          </tr>
        </thead>
        <tbody>
          {safeAreaProps.map((p) => (
            <tr>
              <td><code>{p.name}{p.required ? '' : '?'}</code></td>
              <td><code>{p.type}</code></td>
              <td>{p.default}</td>
              <td>{p.description[lang]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="step">
  <h2>{t('gs.step3.title')}</h2>
  <p>{t('gs.step3.body')}</p>
  <a class="cta" href={`${getRelativeLocaleUrl(lang, '/')}#components`}>{t('gs.cta')} →</a>
</section>

<style>
  .back { font-size: 13px; color: var(--text-light); text-decoration: none; }
  .back:hover { color: var(--primary); }
  h1 { margin: var(--space-lg) 0 var(--space-xs); font-size: 32px; }
  .lede { color: var(--text-light); font-size: 16px; line-height: 1.6; margin-bottom: var(--space-section); }
  .step { margin-bottom: var(--space-section); }
  .step h2 { font-size: 20px; margin: 0 0 var(--space-sm); }
  .eyebrow { margin: var(--space-xxl) 0 var(--space-md); }
  .step p { line-height: 1.6; color: var(--text-light); }
  .install-pair { display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap; }
  .install-pair pre { margin: 0; background: var(--code-bg); }
  .install-or { font-size: 13px; color: var(--text-light); }

  .compat { margin-top: var(--space-xxl); }
  .compat-title { margin: 0 0 var(--space-sm); font-size: 16px; }
  .compat .props-table { margin-top: var(--space-md); }
  .compat-note { font-size: 13px; margin: var(--space-md) 0 0; }
  .compat :global(.callout) { margin-top: var(--space-md); }

  .safe-area {
    margin-top: var(--space-xxl); padding: var(--space-xl) var(--space-xl) var(--space-xs);
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface);
  }
  .safe-area-title { margin-top: 0 !important; color: var(--primary) !important; }
  .safe-area :global(pre) { margin: var(--space-sm) 0 var(--space-md); }
  .safe-area .install-label { margin: var(--space-lg) 0 0; }
  .safe-area :global(.callout) { margin-top: var(--space-md); margin-bottom: var(--space-lg); }
  .step :global(.callout) { margin-top: var(--space-md); }
  .props-note { font-size: 13px; color: var(--text-light); margin: -4px 0 var(--space-md); }

  .props-table { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 10px var(--space-lg); border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--text-light); font-weight: 600; background: var(--code-bg); }
  tr:last-child td { border-bottom: none; }

  .cta {
    display: inline-block; margin-top: var(--space-sm); font-weight: 600; font-size: 14px;
    color: var(--primary); text-decoration: none;
  }
  .cta:hover { color: var(--primary-hover); }
</style>
