---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getEntry } from 'astro:content';
import { Code } from 'astro:components';
import components from '../data/components.json';
import { useTranslations, type Lang } from '../i18n/ui';
import { groupCards } from '../lib/navGroups';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = await getEntry('site', lang);
const content = site!.data;

const groups: [string, string][] = [
  ['atoms', t('group.atoms')],
  ['molecules', t('group.molecules')],
  ['organisms', t('group.organisms')],
];

const total = (['atoms', 'molecules', 'organisms'] as const).reduce(
  (sum, k) => sum + (components as any)[k].length,
  0
);
const codeThemes = { light: 'github-light' as const, dark: 'github-dark' as const };
---

<section class="hero">
  <h1>{content.heroH1}</h1>
  <p class="lede">
    {total} {content.ledePrefix} <code>react</code> {lang === 'es' ? 'y' : 'and'} <code>react-native</code>{' '}
    {content.ledeSuffix}
  </p>
  <div class="install-block">
    <p class="install-label">{content.installCliLabel}</p>
    <Code code={`npx orn-ui add button`} lang="bash" themes={codeThemes} defaultColor={false} />
  </div>
  <div class="install-block">
    <p class="install-label">{content.installPackageLabel}</p>
    <Code code={`pnpm add orn-ui`} lang="bash" themes={codeThemes} defaultColor={false} />
  </div>
  <p class="install-hint">
    {content.installHint}
    {' '}
    <a href={getRelativeLocaleUrl(lang, '/getting-started')}>{t('gs.linkText')} →</a>
    {' · '}
    <a href={getRelativeLocaleUrl(lang, '/atomic-design')}>{t('nav.atomicDesign')} →</a>
  </p>
  <div class="badges">
    {content.badges.map((b) => <span class="badge">{b}</span>)}
  </div>
</section>

<section id="components">
  <div class="filter-bar">
    <svg class="filter-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
    <input
      id="component-filter"
      type="search"
      placeholder={t('home.search.placeholder')}
      aria-label={t('home.search.placeholder')}
    />
  </div>
  <p id="filter-empty" class="filter-empty" hidden>{t('home.search.empty')}</p>

  {groups.map(([key, label]) => (
    <div class="group" data-group>
      <h2>{label}</h2>
      <div class="grid">
        {groupCards((components as any)[key], lang, t).map((c) => (
          <a class="card" href={c.href} data-name={c.filterNames}>
            <div class="card-media">
              <img src={`/media/${c.mediaSlug}.gif`} alt="" loading="lazy" onerror="this.style.display='none'" />
            </div>
            <div class="card-name">{c.label}</div>
          </a>
        ))}
      </div>
    </div>
  ))}
</section>

<script is:inline>
  (function () {
    var input = document.getElementById('component-filter');
    var empty = document.getElementById('filter-empty');
    if (!input) return;
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var anyVisible = false;
      document.querySelectorAll('[data-group]').forEach(function (group) {
        var groupHasMatch = false;
        group.querySelectorAll('.card').forEach(function (card) {
          var match = !q || card.getAttribute('data-name').indexOf(q) !== -1;
          card.hidden = !match;
          if (match) groupHasMatch = true;
        });
        group.hidden = !groupHasMatch;
        if (groupHasMatch) anyVisible = true;
      });
      empty.hidden = anyVisible;
    });
  })();
</script>

<style>
  .hero { padding: 40px 0 56px; border-bottom: 1px solid var(--border); margin-bottom: 40px; }
  .hero h1 { font-size: 40px; line-height: 1.15; margin: 0 0 16px; max-width: 720px; letter-spacing: -0.01em; }
  .lede { color: var(--text-light); font-size: 16px; max-width: 640px; line-height: 1.6; margin-bottom: 20px; }
  .install-block { max-width: 480px; margin-bottom: 14px; }
  .install-block :global(pre) { margin: 6px 0 0; }
  .install-label { font-size: 13px; font-weight: 400; color: var(--text-light); margin: 0; }
  .install-hint { font-size: 13px; color: var(--text-light); margin: 6px 0 20px; }
  .badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .badge {
    font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px;
    background: var(--code-bg); color: var(--text-light); border: 1px solid var(--border);
  }

  .filter-bar {
    display: flex; align-items: center; gap: 8px;
    border: 1px solid var(--border); border-radius: var(--radius);
    padding: 10px 14px; margin-bottom: 32px; background: var(--surface);
    max-width: 360px; transition: border-color 0.15s;
  }
  .filter-bar:focus-within { border-color: var(--primary); box-shadow: var(--focus-ring); }
  .filter-icon { color: var(--text-light); flex-shrink: 0; }
  .filter-bar input {
    border: none; outline: none; background: transparent; color: var(--text);
    font-size: 14px; width: 100%; font-family: inherit;
  }
  .filter-bar input::placeholder { color: var(--text-light); }
  .filter-empty { color: var(--text-light); font-size: 14px; margin: -16px 0 32px; }

  .group { margin-bottom: 40px; }
  .group h2 { font-size: 20px; margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
  .card {
    display: block; text-decoration: none; color: var(--text);
    border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
    background: var(--surface); transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .card:hover { border-color: var(--primary); transform: translateY(-2px); box-shadow: var(--shadow); }
  .card-media {
    aspect-ratio: 16 / 10; background: var(--code-bg);
    display: flex; align-items: center; justify-content: center;
  }
  .card-media img { width: 100%; height: 100%; object-fit: cover; }
  .card-name { padding: 10px 12px; font-size: 13px; font-weight: 600; }
</style>
