---
// Página de grupo: Title, Subtitle, Body y Caption salen del mismo Text.tsx.
// Usa el mismo layout que las páginas individuales, solo cambian los datos.
import { getRelativeLocaleUrl } from 'astro:i18n';
import components from '../data/components.json';
import { useTranslations, type Lang } from '../i18n/ui';
import { getFlatNavList } from '../lib/navGroups';
import ComponentPageLayout, { type DepChip } from './ComponentPageLayout.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Se agrupan por sourceFile en vez de hardcodear los 4 nombres.
const all = [...(components as any).atoms, ...(components as any).molecules, ...(components as any).organisms];
const members = all.filter((c: any) => c.sourceFile === 'Text');
const primary = members.find((m: any) => m.registry) ?? members[0];
// groupVariants: las variantes del demo compartido, sin filtrar por componente.
const allVariants: { label: string; code: string }[] = primary?.groupVariants ?? [];

const usageKeys: Record<string, string> = {
  Title: 'typography.title.usage',
  Subtitle: 'typography.subtitle.usage',
  Body: 'typography.body.usage',
  Caption: 'typography.caption.usage',
};

const usage = members.map((m: any) => ({ term: m.name, desc: t(usageKeys[m.name] as any) }));

// Los 4 apilados, como se usarían en una pantalla real. Sale del demo
// real, no está escrito a mano.
const combinedExample = members
  .map((m: any) => allVariants.find((v) => v.label === m.name)?.code)
  .filter(Boolean)
  .join('\n');

const flatList = getFlatNavList(components, lang, t);
const ownHref = getRelativeLocaleUrl(lang, '/typography');
const ownIndex = flatList.findIndex((item) => item.href === ownHref);
const nextItem = ownIndex !== -1 ? flatList[(ownIndex + 1) % flatList.length] : null;
const prevItem = ownIndex !== -1 ? flatList[(ownIndex - 1 + flatList.length) % flatList.length] : null;

const deps: DepChip[] = (primary?.registry?.registryDependencies ?? []).map(() => ({
  label: t('install.core'),
  italic: true,
}));
---

<ComponentPageLayout
  lang={lang}
  kicker="Atom"
  title={t('typography.name')}
  lede={t('typography.lede')}
  mediaSlug="typography"
  backHref={`${getRelativeLocaleUrl(lang, '/')}#components`}
  providerHref={getRelativeLocaleUrl(lang, '/getting-started')}
  installSlug={primary?.registry ? primary.slug : undefined}
  installImport={`import { ${members.map((m: any) => m.name).join(', ')} } from 'orn-ui/${primary?.slug}';`}
  installNote={t('typography.cherryPick')}
  deps={deps}
  usage={usage}
  combinedExample={combinedExample}
  combinedTitle={t('typography.combined')}
  variants={allVariants}
  props={primary?.props ?? []}
  propsOwner={primary?.name}
  propsNote={t('typography.sharedProps')}
  prevItem={prevItem}
  nextItem={nextItem}
/>
