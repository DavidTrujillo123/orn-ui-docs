---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Code } from 'astro:components';
import components from '../data/components.json';
import { useTranslations, type Lang } from '../i18n/ui';
import { getFlatNavList } from '../lib/navGroups';
import NextItemLink from './NextItemLink.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Los 4 miembros viven en el mismo archivo fuente (Text.tsx) — se agrupan
// acá por sourceFile en vez de hardcodear los 4 nombres, mismo criterio
// que HomeContent.astro usa para armar el tile "Typography".
const all = [...(components as any).atoms, ...(components as any).molecules, ...(components as any).organisms];
const members = all.filter((c: any) => c.sourceFile === 'Text');
const primary = members.find((m: any) => m.registry) ?? members[0];
// groupVariants es la lista SIN filtrar del demo file compartido — las 6
// variantes reales (Title, Subtitle, Body, Caption, align="center",
// custom color), no una reconstruida a mano.
const allVariants: { label: string; code: string }[] = primary?.groupVariants ?? [];

const usageKeys: Record<string, string> = {
  Title: 'typography.title.usage',
  Subtitle: 'typography.subtitle.usage',
  Body: 'typography.body.usage',
  Caption: 'typography.caption.usage',
};

// El "ejemplo combinado": los 4 se usan juntos, apilados, tal como se
// usarían en una pantalla real — es exactamente la primera variante de
// cada uno, ya extraída del demo compartido (sin reescribirla a mano).
const combinedExample = members
  .map((m: any) => allVariants.find((v) => v.label === m.name)?.code)
  .filter(Boolean)
  .join('\n');

// Mismo orden que el sidebar — Typography es el primer item (Atoms),
// "Siguiente" apunta al que sigue.
const flatList = getFlatNavList(components, lang, t);
const ownHref = getRelativeLocaleUrl(lang, '/typography');
const ownIndex = flatList.findIndex((item) => item.href === ownHref);
const nextItem = ownIndex !== -1 ? flatList[(ownIndex + 1) % flatList.length] : null;
const prevItem = ownIndex !== -1 ? flatList[(ownIndex - 1 + flatList.length) % flatList.length] : null;
---

<a class="back" href={`${getRelativeLocaleUrl(lang, '/')}#components`}>{t('component.back')}</a>
<div class="header">
  <span class="kicker">Atom</span>
  <h1>{t('typography.name')}</h1>
</div>
<p class="lede">{t('typography.lede')}</p>

<a class="provider-note" href={getRelativeLocaleUrl(lang, '/getting-started')}>
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
  <span><strong>{t('gs.requiresProvider')}</strong> — {t('gs.linkText')} →</span>
</a>

{primary?.registry && (
  <section class="install">
    <h2>{t('install.title')}</h2>
    <div class="install-option">
      <p class="install-label">{t('install.cli')}</p>
      <Code code={`npx orn-ui add ${primary.slug}`} lang="bash" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
    </div>
    <div class="install-option">
      <p class="install-label">{t('install.package')}</p>
      <Code
        code={`pnpm add orn-ui\nimport { ${members.map((m: any) => m.name).join(', ')} } from 'orn-ui/${primary.slug}';`}
        lang="tsx"
        themes={{ light: 'github-light', dark: 'github-dark' }}
        defaultColor={false}
      />
    </div>
    <p class="install-note">{t('typography.cherryPick')}</p>
    {primary.registry.registryDependencies.length > 0 && (
      <div class="install-deps">
        <span class="install-label">{t('install.dependsOn')}</span>
        {primary.registry.registryDependencies.map((dep: string) => (
          <span class="dep-chip dep-chip-core">{t('install.core')}</span>
        ))}
      </div>
    )}
  </section>
)}

<section class="usage">
  <h2>{t('typography.usage')}</h2>
  <ul class="usage-list">
    {members.map((m: any) => (
      <li><strong>{m.name}</strong> — {t(usageKeys[m.name] as any)}</li>
    ))}
  </ul>
</section>

{combinedExample && (
  <section class="example">
    <h2>{t('typography.combined')}</h2>
    <Code code={combinedExample} lang="tsx" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
  </section>
)}

{allVariants.length > 0 && (
  <section class="variants">
    <h2>{t('component.variants')}</h2>
    {allVariants.map((v) => (
      <div class="variant">
        <h3>{v.label}</h3>
        <Code code={v.code} lang="tsx" themes={{ light: 'github-light', dark: 'github-dark' }} defaultColor={false} />
      </div>
    ))}
  </section>
)}

<h2>{t('component.props')}</h2>
<p class="props-note">{t('typography.sharedProps')}</p>
{primary?.props?.length > 0 ? (
  <div class="props-table">
    <table>
      <thead>
        <tr>
          <th>{t('props.name')}</th>
          <th>{t('props.type')}</th>
          <th>{t('props.default')}</th>
          <th>{t('props.description')}</th>
        </tr>
      </thead>
      <tbody>
        {primary.props.map((p: any) => (
          <tr>
            <td><code>{p.name}{p.required ? '' : '?'}</code></td>
            <td><code>{p.type}</code></td>
            <td>{p.defaultValue ?? '—'}</td>
            <td>{p.description || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
) : (
  <p>{t('component.noProps')}</p>
)}

{(prevItem || nextItem) && (
  <div class="pager-row">
    {prevItem && <NextItemLink direction="prev" href={prevItem.href} label={prevItem.label} eyebrow={t('nav.prev')} />}
    {nextItem && <NextItemLink direction="next" href={nextItem.href} label={nextItem.label} eyebrow={t('nav.next')} />}
  </div>
)}

<style>
  .pager-row { display: flex; gap: 16px; margin-top: 40px; flex-wrap: wrap; }
  @media (max-width: 480px) { .pager-row { flex-direction: column; } }
  .back { font-size: 13px; color: var(--text-light); text-decoration: none; }
  .back:hover { color: var(--primary); }
  .header { margin: 16px 0 12px; }
  .kicker { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--primary); }
  h1 { margin: 4px 0 0; font-size: 32px; }
  .lede { color: var(--text-light); font-size: 15px; max-width: 640px; line-height: 1.6; margin-bottom: 20px; }

  .provider-note {
    display: flex; align-items: center; gap: 8px;
    background: color-mix(in srgb, #f59e0b 12%, var(--surface));
    border: 1px solid color-mix(in srgb, #f59e0b 40%, var(--border));
    color: var(--text);
    border-radius: var(--radius);
    padding: 10px 14px;
    margin-bottom: 24px;
    font-size: 13px;
    text-decoration: none;
  }
  .provider-note svg { flex-shrink: 0; color: #f59e0b; }
  .provider-note:hover { border-color: #f59e0b; }

  h2 { font-size: 20px; margin: 32px 0 12px; }
  .install { margin-bottom: 8px; }
  .install-option { margin-bottom: 14px; }
  .install-option :global(pre) { margin: 4px 0 0; }
  .install-label {
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-light); margin: 0;
  }
  .install-note { font-size: 13px; color: var(--text-light); margin: 4px 0 0; }
  .install-deps { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 16px; }
  .dep-chip {
    font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px;
    background: var(--code-bg); color: var(--text); border: 1px solid var(--border);
  }
  .dep-chip-core { color: var(--text-light); font-style: italic; }

  .usage-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .usage-list li { font-size: 14px; color: var(--text-light); line-height: 1.5; }
  .usage-list strong { color: var(--text); }

  .example :global(pre) { margin: 0; }

  .variants { margin-bottom: 8px; }
  .variants h2 { margin-bottom: 16px; }
  .variant { margin-bottom: 24px; }
  .variant h3 {
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-light); margin: 0 0 8px;
  }
  .variant :global(pre) { margin: 0; }

  .props-note { font-size: 13px; color: var(--text-light); margin: -4px 0 12px; }
  .props-table { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--text-light); font-weight: 600; background: var(--code-bg); }
  tr:last-child td { border-bottom: none; }
</style>
