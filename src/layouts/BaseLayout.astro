---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import { LANGUAGES, LANGUAGE_LABELS, useTranslations, type Lang } from '../i18n/ui';
import { GITHUB_URL, NPM_URL } from '../lib/links';
import NpmIcon from '../components/icons/NpmIcon.astro';
import GithubIcon from '../components/icons/GithubIcon.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Route without a language prefix. Feeds the EN/ES switcher and the hreflangs. */
  path?: string;
  /** .md version of this page, if it exists. Exposed as rel="alternate". */
  markdownUrl?: string;
  /** JSON-LD already built by the page. */
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = 'orn-ui — a fast, atomic-design component library for React Native.',
  lang = 'en',
  path = '/',
  markdownUrl,
  jsonLd,
} = Astro.props;
const t = useTranslations(lang);
const site = await getEntry('site', lang);
const footerText = site?.data.footer ?? '';

const canonicalUrl = new URL(getRelativeLocaleUrl(lang, path), Astro.site);
const hasSidebar = Astro.slots.has('sidebar');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · orn-ui</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {LANGUAGES.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(getRelativeLocaleUrl(l, path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('en', path), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="orn-ui" />
    <meta property="og:title" content={`${title} · orn-ui`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · orn-ui`} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%232f6bff%22/></svg>" />
    <meta name="theme-color" id="theme-color-meta" content="#f7f8fa" />

    {markdownUrl && (
      <link rel="alternate" type="text/markdown" href={new URL(markdownUrl, Astro.site)} title={`${title} (Markdown)`} />
    )}
    <link rel="alternate" type="text/plain" href={new URL('/llms.txt', Astro.site)} title="orn-ui — llms.txt" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />

    <!-- Applies the saved theme before the first paint to avoid the wrong-theme
         flash, and keeps <meta theme-color> in sync. -->
    <script is:inline>
      (function () {
        var KEY = 'orn-ui-theme';
        var BG = { light: '#f7f8fa', dark: '#0a0c10' };
        function apply() {
          var saved = null;
          try { saved = localStorage.getItem(KEY); } catch (e) {}
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
          var explicit = document.documentElement.getAttribute('data-theme');
          var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var effective = explicit || (systemDark ? 'dark' : 'light');
          var meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', BG[effective]);
          var btn = document.getElementById('theme-toggle');
          if (btn) btn.setAttribute('aria-pressed', String(effective === 'dark'));
        }
        window.__ornSyncThemeColor = apply;
        apply();
        document.addEventListener('astro:before-swap', apply);
        document.addEventListener('astro:page-load', apply);
      })();
    </script>
  </head>
  <body data-toast-code={t('toast.copiedCode')} data-toast-md={t('toast.copiedMd')}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={getRelativeLocaleUrl(lang, '/')}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span translate="no">orn-ui</span>
        </a>
        <nav class="topnav" aria-label="Primary">
          <a href={getRelativeLocaleUrl(lang, '/getting-started')}>{t('nav.gettingStarted')}</a>
          <a href={`${getRelativeLocaleUrl(lang, '/')}#components`}>{t('nav.components')}</a>
          <a href={getRelativeLocaleUrl(lang, '/tokens')}>{t('nav.tokens')}</a>
          <a class="icon-link" href={NPM_URL} rel="noopener" aria-label={t('nav.npm')} title={t('nav.npm')}>
            <NpmIcon width="16" height="16" />
          </a>
          <a class="icon-link" href={GITHUB_URL} rel="noopener" aria-label={t('nav.github')} title={t('nav.github')}>
            <GithubIcon width="18" height="18" />
          </a>
          <button type="button" id="donate-trigger" class="donate-link" aria-haspopup="dialog" aria-controls="donate-modal">
            {t('nav.donate')}
          </button>

          <button type="button" id="search-trigger" class="search-trigger" aria-haspopup="dialog" aria-controls="search-modal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <span class="search-trigger-label">{t('search.button')}</span>
            <kbd class="search-kbd">⌘K</kbd>
          </button>

          <span class="lang-switch">
            {LANGUAGES.map((l, i) => (
              <>
                {i > 0 && <span class="lang-sep">/</span>}
                {l === lang ? (
                  <span class="lang-current" aria-current="true">{LANGUAGE_LABELS[l]}</span>
                ) : (
                  <a href={getRelativeLocaleUrl(l, path)}>{LANGUAGE_LABELS[l]}</a>
                )}
              </>
            ))}
          </span>
          <button type="button" id="theme-toggle" class="theme-toggle" aria-label={t('theme.toggle')} aria-pressed="false">
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg>
          </button>
        </nav>
      </header>

      <div class:list={['page', { 'page-with-sidebar': hasSidebar }]}>
        {hasSidebar && (
          <aside class="sidebar-col" transition:persist="sidebar" transition:animate="none">
            <details class="sidebar-disclosure" open>
              <summary class="sidebar-summary">
                {t('sidebar.toggle')}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <slot name="sidebar" />
            </details>
          </aside>
        )}
        <main id="main" transition:animate="fade">
          <slot />
        </main>
      </div>

      <footer class="footer">
        <span>{footerText}</span>
        <span aria-hidden="true">-</span>
        <button type="button" id="donate-trigger-footer" class="donate-link footer-donate-link" aria-haspopup="dialog" aria-controls="donate-modal">
          {t('nav.donate')}
        </button>
      </footer>
    </div>

    <div id="search-modal" role="dialog" aria-modal="true" aria-label={t('search.button')} hidden>
      <div class="search-backdrop"></div>
      <div class="search-panel">
        <div class="search-input-row">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input
            id="search-input"
            type="text"
            role="combobox"
            aria-expanded="true"
            aria-controls="search-results"
            aria-autocomplete="list"
            autocomplete="off"
            spellcheck="false"
            placeholder={t('search.placeholder')}
          />
          <button type="button" id="search-close" aria-label={t('search.close')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
        <p class="search-hint">{t('search.hint')}</p>
        <ul id="search-results" class="search-results" role="listbox"></ul>
        <p id="search-empty-msg" class="search-empty" hidden>{t('search.empty')}</p>
      </div>
    </div>

    <div id="donate-modal" role="dialog" aria-modal="true" aria-labelledby="donate-title" hidden>
      <div class="donate-backdrop"></div>
      <div class="donate-panel">
        <button type="button" id="donate-close" class="donate-close" aria-label={t('search.close')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <span class="donate-icon" aria-hidden="true">♥</span>
        <h2 id="donate-title" class="donate-title">{t('footer.donate')}</h2>
        <p class="donate-desc">{t('donate.desc')}</p>
        <div class="donate-widget">
          <div id="paypal-container-DGFLEHMADF546"></div>
          <span class="donate-spinner" aria-hidden="true"></span>
        </div>
      </div>
    </div>

    <script src="/copy.js" defer></script>
    <script src="/search.js" defer></script>
    <script is:inline>
      // Donation modal. The PayPal SDK is only requested when the modal is
      // first opened (not on every page load) and the button is rendered
      // just once; ClientRouter navigations don't touch it because the
      // modal lives outside <main>.
      (function () {
        var sdkPromise = null;

        function loadSdk() {
          if (!sdkPromise) {
            sdkPromise = new Promise(function (resolve) {
              var script = document.createElement('script');
              script.src = 'https://www.paypal.com/sdk/js?client-id=BAAEHAKfLvxQx55Ve1rlI7wuqwMcw4eMhrOIT1K8mAGAU259-t7w0HgK9VkrzUs1dKvD5twH9reA5x-l7o&components=hosted-buttons&disable-funding=venmo&currency=USD';
              script.onload = resolve;
              document.head.appendChild(script);
            });
          }
          return sdkPromise;
        }

        function renderDonateButton() {
          loadSdk().then(function () {
            var container = document.getElementById('paypal-container-DGFLEHMADF546');
            if (!container || container.dataset.rendered) return;
            container.dataset.rendered = '1';
            window.paypal.HostedButtons({
              hostedButtonId: 'DGFLEHMADF546',
            }).render('#paypal-container-DGFLEHMADF546').then(function () {
              var spinner = document.querySelector('.donate-spinner');
              if (spinner) spinner.remove();
            });
          });
        }

        function isOpen() {
          var modal = document.getElementById('donate-modal');
          return !!modal && !modal.hidden;
        }

        var lastTrigger = null;

        function open(trigger) {
          var modal = document.getElementById('donate-modal');
          if (!modal) return;
          lastTrigger = trigger || null;
          modal.hidden = false;
          document.documentElement.style.overflow = 'hidden';
          renderDonateButton();
          var close = document.getElementById('donate-close');
          setTimeout(function () { if (close) close.focus(); }, 0);
        }

        function close() {
          var modal = document.getElementById('donate-modal');
          if (!modal) return;
          modal.hidden = true;
          document.documentElement.style.overflow = '';
          if (lastTrigger) lastTrigger.focus();
        }

        document.addEventListener('click', function (e) {
          var trigger = e.target.closest('#donate-trigger, #donate-trigger-footer');
          if (trigger) { open(trigger); return; }
          if (e.target.closest('#donate-close') || e.target.closest('.donate-backdrop')) { close(); }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && isOpen()) close();
        });
      })();
    </script>
    <script is:inline>
      (function () {
        // A component's clip plays in a loop: it's what replaces the GIF.
        // Two reasons why the <video>'s `autoplay` attribute isn't enough:
        //
        // 1. Some browsers block autoplay by policy even when the video is
        //    muted (Brave does it out of the box). Measured with CDP:
        //    paused=true, currentTime=0, readyState=4 — loaded and stopped,
        //    no error. A play() from script does start it.
        // 2. With ClientRouter, a client navigation doesn't re-run the inline
        //    scripts of the incoming content. That's why this lives here and
        //    hooks into astro:page-load, like the rest of the site's scripts:
        //    otherwise, the video only moved after reloading the page.
        function wire() {
          var videos = document.querySelectorAll('.media-frame video, .variant-shot video');
          if (!videos.length) return;

          // "Reduce motion" is precisely the request that a loop not play on
          // its own: it stays on the poster with controls, one click away
          // from being seen. It can't be solved with CSS — autoplay isn't style.
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            videos.forEach(function (video) {
              video.removeAttribute('autoplay');
              video.controls = true;
              video.pause();
            });
            return;
          }

          videos.forEach(function (video) {
            if (video.dataset.wired) return;
            video.dataset.wired = '1';

            var play = function () {
              // After a ClientRouter navigation the <video> arrives with its
              // src attribute intact but with no source selected
              // (networkState NETWORK_NO_SOURCE, empty currentSrc): the
              // element was adopted into the new document without re-running
              // resource selection, and play() fails with
              // NotSupportedError "The element has no supported sources".
              // load() triggers it again. Verified with CDP: without this the
              // clip only started by reloading the page by hand.
              if (!video.currentSrc || video.networkState === video.NETWORK_NO_SOURCE) video.load();

              var started = video.play();
              // If the browser still rejects it, controls: the demo is still
              // there, but on demand. Worse would be a silent, unexplained poster.
              if (started && started.catch) started.catch(function () { video.controls = true; });
            };

            if (!('IntersectionObserver' in window)) { play(); return; }
            // Off screen it doesn't decode: the clip is at the very top, but
            // whoever scrolls down to the props doesn't need the loop spinning.
            new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) play();
                else video.pause();
              });
            }, { threshold: 0.25 }).observe(video);
          });
        }
        wire();
        document.addEventListener('astro:page-load', wire);
      })();
    </script>
    <script is:inline>
      // The sidebar is served as <details open> so it's visible without JS;
      // this only collapses it on a small viewport.
      (function () {
        var mq = window.matchMedia('(max-width: 900px)');
        function sync(e) {
          var d = document.querySelector('.sidebar-disclosure');
          if (!d) return;
          if (e.matches) d.removeAttribute('open');
          else d.setAttribute('open', '');
        }
        var run = function () { sync(mq); };
        run();
        mq.addEventListener('change', sync);
        document.addEventListener('astro:page-load', run);
      })();
    </script>
    <script is:inline>
      (function () {
        var KEY = 'orn-ui-theme';
        function wire() {
          var btn = document.getElementById('theme-toggle');
          if (!btn || btn.dataset.wired) return;
          btn.dataset.wired = '1';
          btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme');
            var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var currentlyDark = current ? current === 'dark' : systemDark;
            var next = currentlyDark ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            // Save before syncing: __ornSyncThemeColor reapplies the saved
            // theme, and with the old value it undid the click (one out of
            // two did nothing).
            try { localStorage.setItem(KEY, next); } catch (e) {}
            if (window.__ornSyncThemeColor) window.__ornSyncThemeColor();
          });
        }
        wire();
        document.addEventListener('astro:page-load', wire);
      })();
    </script>
    <script is:inline>
      // Topbar shadow on scroll: with just blur + a 1px border, the content
      // passing underneath competed visually with the fixed bar. `scroll`
      // with passive, not an IntersectionObserver — there's no sentinel to
      // keep in sync with the header's real height.
      (function () {
        var topbar = null;
        function sync() {
          if (!topbar) topbar = document.querySelector('.topbar');
          if (!topbar) return;
          topbar.classList.toggle('is-scrolled', window.scrollY > 4);
        }
        sync();
        window.addEventListener('scroll', sync, { passive: true });
        document.addEventListener('astro:page-load', sync);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --primary: #2f6bff;
    --primary-hover: #1d54e0;
    --secondary: #00c2d4;
    --bg: #f7f8fa;
    --surface: #ffffff;
    --surface-hover: #f0f2f5;
    /* Explicit elevation, same direction in both themes: sunken < bg <
       surface < surface-active. code-bg is an alias of sunken — "code" isn't
       a surface of its own, it's sunken content, just like a media GIF or a
       token swatch. */
    --surface-sunken: #eef1f5;
    --surface-active: color-mix(in srgb, var(--primary) 10%, var(--surface));
    --code-bg: var(--surface-sunken);
    --text: #1a1d21;
    --text-light: #5b6572;
    --border: #e3e6ea;
    --radius: 12px;
    --shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    --focus-ring: 0 0 0 3px rgba(47, 107, 255, 0.35);
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --primary: #6ea1ff;
      --primary-hover: #8db3ff;
      --secondary: #2fe3f2;
      --bg: #0a0c10;
      --surface: #14171c;
      --surface-hover: #1b1f26;
      /* Same direction as in light: sunken ends up darker than bg, not
         lighter — otherwise "code = sunken" flips between themes. */
      --surface-sunken: #07090c;
      --surface-active: color-mix(in srgb, var(--primary) 14%, var(--surface));
      --code-bg: var(--surface-sunken);
      --text: #edeef0;
      --text-light: #97a1ad;
      --border: #262b33;
      --shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
      --focus-ring: 0 0 0 3px rgba(110, 161, 255, 0.4);
      color-scheme: dark;
    }
  }

  :root[data-theme='dark'] {
    --primary: #6ea1ff;
    --primary-hover: #8db3ff;
    --secondary: #2fe3f2;
    --bg: #0a0c10;
    --surface: #14171c;
    --surface-hover: #1b1f26;
    --surface-sunken: #07090c;
    --surface-active: color-mix(in srgb, var(--primary) 14%, var(--surface));
    --code-bg: var(--surface-sunken);
    --text: #edeef0;
    --text-light: #97a1ad;
    --border: #262b33;
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    --focus-ring: 0 0 0 3px rgba(110, 161, 255, 0.4);
    color-scheme: dark;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    /* `clip` and not `hidden`: `hidden` creates a scroll container and
       would break the topbar's and sidebar's position:sticky. */
    overflow-x: clip;
  }

  h1 { text-wrap: balance; overflow-wrap: break-word; }

  a, button {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }

  ::selection { background: var(--secondary); color: #04222b; }

  :focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 4px;
  }

  /* The site's only eyebrow (uppercase + tracking + --text-sm). It used to
     appear at 11/12/13px depending on the file — the same signal ("this is a
     category, not prose") read as three different signals. The color
     (primary vs text-light) is the only allowed variation. */
  .eyebrow {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--primary);
    color: #fff;
    padding: 10px 16px;
    border-radius: 0 0 8px 0;
    z-index: 100;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  .skip-link:focus { left: 0; }

  .shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 24px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    z-index: 10;
    transition: box-shadow var(--duration-fast);
  }
  .topbar.is-scrolled { box-shadow: var(--shadow); }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 18px;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    display: inline-block;
  }

  .topnav {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    row-gap: 8px;
  }

  .topnav a {
    color: var(--text-light);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s;
  }

  .topnav a:hover { color: var(--primary); }

  .icon-link { display: flex; align-items: center; opacity: 0.75; transition: opacity 0.15s; }
  .icon-link:hover { opacity: 1; }
  .icon-link :global(svg) { display: block; border-radius: 3px; }

  .donate-link {
    color: var(--text-light);
    font-weight: 500;
    font-size: 14px;
    font-family: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
