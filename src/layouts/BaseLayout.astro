---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import { LANGUAGES, LANGUAGE_LABELS, useTranslations, type Lang } from '../i18n/ui';
import { GITHUB_URL, NPM_URL } from '../lib/links';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Ruta sin prefijo de idioma. Alimenta el switcher EN/ES y las hreflang. */
  path?: string;
  /** Versión .md de esta página, si existe. Se expone como rel="alternate". */
  markdownUrl?: string;
  /** JSON-LD ya armado por la página. */
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = 'orn-ui — a fast, atomic-design component library for React Native.',
  lang = 'en',
  path = '/',
  markdownUrl,
  jsonLd,
} = Astro.props;
const t = useTranslations(lang);
const site = await getEntry('site', lang);
const footerText = site?.data.footer ?? '';

const canonicalUrl = new URL(getRelativeLocaleUrl(lang, path), Astro.site);
const hasSidebar = Astro.slots.has('sidebar');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · orn-ui</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {LANGUAGES.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(getRelativeLocaleUrl(l, path), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('en', path), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="orn-ui" />
    <meta property="og:title" content={`${title} · orn-ui`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · orn-ui`} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%232f6bff%22/></svg>" />
    <meta name="theme-color" id="theme-color-meta" content="#f7f8fa" />

    {markdownUrl && (
      <link rel="alternate" type="text/markdown" href={new URL(markdownUrl, Astro.site)} title={`${title} (Markdown)`} />
    )}
    <link rel="alternate" type="text/plain" href={new URL('/llms.txt', Astro.site)} title="orn-ui — llms.txt" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />

    <!-- Aplica el theme guardado antes del primer paint para evitar el
         flash de tema equivocado, y mantiene <meta theme-color> en sync. -->
    <script is:inline>
      (function () {
        var KEY = 'orn-ui-theme';
        var BG = { light: '#f7f8fa', dark: '#0a0c10' };
        function apply() {
          var saved = null;
          try { saved = localStorage.getItem(KEY); } catch (e) {}
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
          var explicit = document.documentElement.getAttribute('data-theme');
          var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var effective = explicit || (systemDark ? 'dark' : 'light');
          var meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', BG[effective]);
          var btn = document.getElementById('theme-toggle');
          if (btn) btn.setAttribute('aria-pressed', String(effective === 'dark'));
        }
        window.__ornSyncThemeColor = apply;
        apply();
        document.addEventListener('astro:before-swap', apply);
        document.addEventListener('astro:page-load', apply);
      })();
    </script>
  </head>
  <body data-toast-code={t('toast.copiedCode')} data-toast-md={t('toast.copiedMd')}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={getRelativeLocaleUrl(lang, '/')}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span translate="no">orn-ui</span>
        </a>
        <nav class="topnav" aria-label="Primary">
          <a href={getRelativeLocaleUrl(lang, '/getting-started')}>{t('nav.gettingStarted')}</a>
          <a href={`${getRelativeLocaleUrl(lang, '/')}#components`}>{t('nav.components')}</a>
          <a href={getRelativeLocaleUrl(lang, '/tokens')}>{t('nav.tokens')}</a>
          <a href={NPM_URL} rel="noopener">{t('nav.npm')}</a>
          <a href={GITHUB_URL} rel="noopener">{t('nav.github')}</a>

          <button type="button" id="search-trigger" class="search-trigger" aria-haspopup="dialog" aria-controls="search-modal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
            <span class="search-trigger-label">{t('search.button')}</span>
            <kbd class="search-kbd">⌘K</kbd>
          </button>

          <span class="lang-switch">
            {LANGUAGES.map((l, i) => (
              <>
                {i > 0 && <span class="lang-sep">/</span>}
                {l === lang ? (
                  <span class="lang-current" aria-current="true">{LANGUAGE_LABELS[l]}</span>
                ) : (
                  <a href={getRelativeLocaleUrl(l, path)}>{LANGUAGE_LABELS[l]}</a>
                )}
              </>
            ))}
          </span>
          <button type="button" id="theme-toggle" class="theme-toggle" aria-label={t('theme.toggle')} aria-pressed="false">
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg>
          </button>
        </nav>
      </header>

      <div class:list={['page', { 'page-with-sidebar': hasSidebar }]}>
        {hasSidebar && (
          <aside class="sidebar-col" transition:persist="sidebar" transition:animate="none">
            <details class="sidebar-disclosure" open>
              <summary class="sidebar-summary">
                {t('sidebar.toggle')}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <slot name="sidebar" />
            </details>
          </aside>
        )}
        <main id="main" transition:animate="fade">
          <slot />
        </main>
      </div>

      <footer class="footer">
        <span>{footerText}</span>
      </footer>
    </div>

    <div id="search-modal" role="dialog" aria-modal="true" aria-label={t('search.button')} hidden>
      <div class="search-backdrop"></div>
      <div class="search-panel">
        <div class="search-input-row">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input
            id="search-input"
            type="text"
            role="combobox"
            aria-expanded="true"
            aria-controls="search-results"
            aria-autocomplete="list"
            autocomplete="off"
            spellcheck="false"
            placeholder={t('search.placeholder')}
          />
          <button type="button" id="search-close" aria-label={t('search.close')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
        <p class="search-hint">{t('search.hint')}</p>
        <ul id="search-results" class="search-results" role="listbox"></ul>
        <p id="search-empty-msg" class="search-empty" hidden>{t('search.empty')}</p>
      </div>
    </div>

    <script src="/copy.js" defer></script>
    <script src="/search.js" defer></script>
    <script is:inline>
      // El sidebar se sirve como <details open> para que sea visible sin
      // JS; esto solo lo colapsa en viewport chico.
      (function () {
        var mq = window.matchMedia('(max-width: 900px)');
        function sync(e) {
          var d = document.querySelector('.sidebar-disclosure');
          if (!d) return;
          if (e.matches) d.removeAttribute('open');
          else d.setAttribute('open', '');
        }
        var run = function () { sync(mq); };
        run();
        mq.addEventListener('change', sync);
        document.addEventListener('astro:page-load', run);
      })();
    </script>
    <script is:inline>
      (function () {
        var KEY = 'orn-ui-theme';
        function wire() {
          var btn = document.getElementById('theme-toggle');
          if (!btn || btn.dataset.wired) return;
          btn.dataset.wired = '1';
          btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme');
            var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var currentlyDark = current ? current === 'dark' : systemDark;
            var next = currentlyDark ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            if (window.__ornSyncThemeColor) window.__ornSyncThemeColor();
            try { localStorage.setItem(KEY, next); } catch (e) {}
          });
        }
        wire();
        document.addEventListener('astro:page-load', wire);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --primary: #2f6bff;
    --primary-hover: #1d54e0;
    --secondary: #00c2d4;
    --bg: #f7f8fa;
    --surface: #ffffff;
    --surface-hover: #f0f2f5;
    --text: #1a1d21;
    --text-light: #5b6572;
    --border: #e3e6ea;
    --code-bg: #f4f6f8;
    --radius: 12px;
    --shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    --focus-ring: 0 0 0 3px rgba(47, 107, 255, 0.35);
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --primary: #6ea1ff;
      --primary-hover: #8db3ff;
      --secondary: #2fe3f2;
      --bg: #0a0c10;
      --surface: #14171c;
      --surface-hover: #1b1f26;
      --text: #edeef0;
      --text-light: #97a1ad;
      --border: #262b33;
      --code-bg: #101317;
      --shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
      --focus-ring: 0 0 0 3px rgba(110, 161, 255, 0.4);
      color-scheme: dark;
    }
  }

  :root[data-theme='dark'] {
    --primary: #6ea1ff;
    --primary-hover: #8db3ff;
    --secondary: #2fe3f2;
    --bg: #0a0c10;
    --surface: #14171c;
    --surface-hover: #1b1f26;
    --text: #edeef0;
    --text-light: #97a1ad;
    --border: #262b33;
    --code-bg: #101317;
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    --focus-ring: 0 0 0 3px rgba(110, 161, 255, 0.4);
    color-scheme: dark;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    /* `clip` y no `hidden`: `hidden` crea un contenedor de scroll y
       rompería el position:sticky del topbar y del sidebar. */
    overflow-x: clip;
  }

  h1 { text-wrap: balance; overflow-wrap: break-word; }

  a, button {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }

  ::selection { background: var(--secondary); color: #04222b; }

  :focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 4px;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--primary);
    color: #fff;
    padding: 10px 16px;
    border-radius: 0 0 8px 0;
    z-index: 100;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  .skip-link:focus { left: 0; }

  .shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 24px;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 18px;
    color: var(--text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    display: inline-block;
  }

  .topnav {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    row-gap: 8px;
  }

  .topnav a {
    color: var(--text-light);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s;
  }

  .topnav a:hover { color: var(--primary); }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-light);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 10px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .search-trigger:hover { color: var(--primary); border-color: var(--primary); }
  .search-kbd {
    font-family: inherit;
    font-size: 11px;
    color: var(--text-light);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 5px;
  }
  @media (max-width: 720px) {
    .search-trigger-label { display: none; }
    .search-kbd { display: none; }
    /* Los links de texto se mantienen visibles: la home no tiene sidebar
       y esconderlos la dejaría sin navegación. */
    .topbar {
      padding: 10px 16px;
      gap: 10px;
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .topnav {
      gap: 8px 12px;
      justify-content: flex-end;
      flex: 1;
      min-width: 0;
    }
    .topnav a { font-size: 13px; }
    .lang-switch { padding-left: 10px; }
    .brand { font-size: 16px; }
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 600;
    padding-left: 16px;
    border-left: 1px solid var(--border);
  }
  .lang-switch a { color: var(--text-light); }
  .lang-switch a:hover { color: var(--primary); }
  .lang-current { color: var(--primary); }
  .lang-sep { color: var(--border); }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-light);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .theme-toggle:hover { color: var(--primary); border-color: var(--primary); }
  .theme-toggle .icon-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .icon-sun { display: none; }
    :root:not([data-theme='light']) .theme-toggle .icon-moon { display: block; }
  }
  :root[data-theme='dark'] .theme-toggle .icon-sun { display: none; }
  :root[data-theme='dark'] .theme-toggle .icon-moon { display: block; }

  .page {
    flex: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
  }

  .page-with-sidebar {
    max-width: 1280px;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    padding: 0 24px;
  }
  .page-with-sidebar main { padding: 40px 0 80px; }
  .sidebar-col {
    position: sticky;
    top: 73px;
    max-height: calc(100vh - 73px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 32px 4px 40px 0;
  }
  /* Un <details> sin `open` esconde su contenido desde el shadow DOM del
     navegador, no con `display` en los hijos: por eso el markup lleva
     `open` fijo y lo colapsa un script, no CSS. */
  .sidebar-summary { display: none; }

  @media (max-width: 900px) {
    /* minmax(0, 1fr) y no "1fr": un track sin mínimo explícito se estira
       hasta el min-content de sus hijos, y un <pre> largo desbordaba la
       página entera. */
    .page-with-sidebar { grid-template-columns: minmax(0, 1fr); }
    .sidebar-col {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 20px 0 0;
    }
    .sidebar-disclosure {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .sidebar-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .sidebar-summary::-webkit-details-marker { display: none; }
    .sidebar-summary svg { transition: transform 0.15s; flex-shrink: 0; }
    .sidebar-disclosure[open] .sidebar-summary { border-bottom: 1px solid var(--border); }
    .sidebar-disclosure[open] .sidebar-summary svg { transform: rotate(180deg); }
    .sidebar-disclosure .sidebar {
      max-height: 50vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 8px 16px 16px;
    }
  }

  main {
    width: 100%;
    padding: 40px 24px 80px;
  }

  .footer {
    padding: 24px;
    text-align: center;
    color: var(--text-light);
    font-size: 13px;
    border-top: 1px solid var(--border);
  }

  code, pre {
    font-family: SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
  }

  pre {
    max-width: 100%;
    border-radius: var(--radius);
    padding: 16px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
    border: 1px solid var(--border);
  }

  /* Sincroniza los bloques shiki con el toggle manual, no solo con
     prefers-color-scheme. Requiere defaultColor={false} en cada <Code>. */
  html[data-theme='dark'] .astro-code,
  html[data-theme='dark'] .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
  @media (prefers-color-scheme: dark) {
    html:not([data-theme='light']) .astro-code,
    html:not([data-theme='light']) .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
      text-decoration: var(--shiki-dark-text-decoration) !important;
    }
  }

  .code-wrap { position: relative; }
  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-light);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s, border-color 0.15s;
  }
  .code-wrap:hover .copy-btn,
  .copy-btn:focus-visible { opacity: 1; }
  .copy-btn:hover { color: var(--primary); border-color: var(--primary); }
  .copy-btn.copied { color: #16a34a; border-color: #16a34a; opacity: 1; }

  a { color: var(--primary); }
  a:hover { color: var(--primary-hover); }

  .toast-root {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }
  .toast {
    background: var(--text);
    color: var(--bg);
    font-size: 13px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 999px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .toast.show { opacity: 1; transform: translateY(0); }

  #search-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 16px 16px;
  }
  /* El selector por id le gana al [hidden] del navegador; sin este
     override el atributo hidden no haría nada. */
  #search-modal:not([hidden]) {
    display: flex;
  }
  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 12, 16, 0.5);
  }
  .search-panel {
    position: relative;
    width: 100%;
    max-width: 560px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }
