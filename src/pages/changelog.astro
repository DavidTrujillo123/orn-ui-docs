---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangelogContent from '../components/ChangelogContent.astro';
import Sidebar from '../components/Sidebar.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('en');
---

<BaseLayout title={t('changelog.title')} description={t('changelog.description')} lang="en" path="/changelog" markdownUrl="/changelog.md">
  <Sidebar slot="sidebar" lang="en" />
  <ChangelogContent lang="en" />
</BaseLayout>
