---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtomicDesignContent from '../../components/AtomicDesignContent.astro';
import Sidebar from '../../components/Sidebar.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('es');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'Diseño atómico — orn-ui',
  description: t('ad.description'),
  inLanguage: 'es',
  isPartOf: { '@type': 'WebSite', name: 'orn-ui', url: 'https://orn-ui-docs.vercel.app' },
};
---

<BaseLayout title={t('ad.title')} description={t('ad.description')} lang="es" path="/atomic-design" markdownUrl="/atomic-design.md" jsonLd={jsonLd}>
  <Sidebar slot="sidebar" lang="es" />
  <AtomicDesignContent lang="es" />
</BaseLayout>
