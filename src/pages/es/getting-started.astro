---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GettingStartedContent from '../../components/GettingStartedContent.astro';
import Sidebar from '../../components/Sidebar.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('es');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'Empezando — orn-ui',
  description: t('gs.description'),
  inLanguage: 'es',
  isPartOf: { '@type': 'WebSite', name: 'orn-ui', url: 'https://orn-ui-docs.vercel.app' },
};
---

<BaseLayout title={t('gs.title')} description={t('gs.description')} lang="es" path="/getting-started" markdownUrl="/getting-started.md" jsonLd={jsonLd}>
  <Sidebar slot="sidebar" lang="es" />
  <GettingStartedContent lang="es" />
</BaseLayout>
