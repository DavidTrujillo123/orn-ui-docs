---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TokensContent from '../../components/TokensContent.astro';
import Sidebar from '../../components/Sidebar.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('es');
---

<BaseLayout title={t('tokens.title')} description={t('tokens.description')} lang="es" path="/tokens">
  <Sidebar slot="sidebar" lang="es" />
  <TokensContent lang="es" />
</BaseLayout>
