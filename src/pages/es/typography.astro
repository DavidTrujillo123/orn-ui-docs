---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TypographyContent from '../../components/TypographyContent.astro';
import Sidebar from '../../components/Sidebar.astro';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('es');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'Tipografía — orn-ui',
  description: t('typography.description'),
  about: 'Atom',
  inLanguage: 'es',
  isPartOf: { '@type': 'WebSite', name: 'orn-ui', url: 'https://orn-ui.dev' },
};
---

<BaseLayout title={t('typography.name')} description={t('typography.description')} lang="es" path="/typography" jsonLd={jsonLd}>
  <Sidebar slot="sidebar" lang="es" />
  <TypographyContent lang="es" />
</BaseLayout>
