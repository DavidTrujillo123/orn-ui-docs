---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { getEntry } from 'astro:content';

const site = await getEntry('site', 'en');
const description = 'orn-ui — a fast, atomic-design component library for React Native and Expo SDK 54–57. Zero runtime dependencies.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'orn-ui',
  description,
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'React Native',
  codeRepository: 'https://github.com/',
  url: 'https://orn-ui-docs.vercel.app',
  inLanguage: 'en',
};
---

<BaseLayout title={site!.data.tabTitle} description={description} lang="en" path="/" jsonLd={jsonLd}>
  <HomeContent lang="en" />
</BaseLayout>
